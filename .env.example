# A1 Marine Storage — environment variables (Vite).
#
# Copy to `.env` in this directory (repo root — Vite's envDir) for local dev, or
# set as Railway service variables for production. Every VITE_-prefixed value is
# PUBLIC and inlined into the client bundle at BUILD time — never put a server
# secret behind a VITE_ var. Because they are build-time, changing one in Railway
# requires a REDEPLOY to take effect.

# ── Analytics: GA4 + Google Ads ──────────────────────────────────────────────
# GA4 Measurement ID (optional). Defaults to G-Z629H2P6LQ in production builds; set
# here / in Railway only to override it. Dev stays clean unless this is set.
VITE_GA4_MEASUREMENT_ID=

# Google Ads conversion ID (optional), e.g. AW-XXXXXXXXX. Loaded alongside GA4
# in the same gtag loader so importing conversions / enhanced conversions is a
# config change later, not a code change. Leave blank until needed.
VITE_GOOGLE_ADS_ID=

# Set to "true" to enable gtag debug_mode (events show in GA4 DebugView). Leave
# unset/blank in production.
VITE_GA4_DEBUG=

# ── Meta (Facebook) Pixel ─────────────────────────────────────────────────────
# Public client-side pixel ID. Defaults to the A1 Marine Storage pixel
# (2437586250097446) baked into production builds; set here/in Railway only to
# override it. Only fires in production builds (never local dev).
VITE_META_PIXEL_ID=

# ── Google Maps (facility & contact map — client/src/components/Map.tsx) ──────
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# ── App / OAuth (client/src/const.ts) ────────────────────────────────────────
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ── Booking deposit copy (client/src/pages/Calculator.tsx) ────────────────────
# Presentational toggle: flips the calculator from "quote request" to "pay a deposit
# to reserve." Turn ON ("1") ONLY once EmpireVu's deposit + auto-send path is live
# (JOBBER_SYNC_ENABLED + Jobber Payments enabled) — otherwise the site promises a
# secure pay link that doesn't arrive yet. Keep the percent matched to EmpireVu's
# JOBBER_DEPOSIT_PERCENT.
VITE_BOOKING_DEPOSIT_ENABLED=
VITE_BOOKING_DEPOSIT_PERCENT=25
